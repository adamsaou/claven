---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (async () => {
  const docs = await getCollection('docs')
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }))
}) satisfies GetStaticPaths

const { doc } = Astro.props
const { Content } = await render(doc)

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order)
---

<Base title={doc.data.title} description={doc.data.description}>
  <div class="mx-auto grid max-w-5xl gap-12 px-5 py-16 md:grid-cols-[13rem_1fr]">
    {/* Sidebar first in the DOM so keyboard order matches reading order. */}
    <nav aria-label="Docs">
      <span class="text-ink-dim text-[10px] font-medium uppercase" style="letter-spacing: 0.14em">
        docs
      </span>
      <ul class="mt-4 space-y-1">
        {
          docs.map((entry) => (
            <li>
              <a
                href={`/docs/${entry.id}`}
                aria-current={entry.id === doc.id ? 'page' : undefined}
                class:list={[
                  'relative block py-1 ps-3 text-[13px] transition-colors',
                  entry.id === doc.id ? 'text-ink' : 'text-ink-muted hover:text-ink'
                ]}
                style="transition-duration: var(--dur-micro)"
              >
                {entry.id === doc.id && (
                  <span class="bg-ember absolute inset-y-0 start-0 w-0.5" aria-hidden="true" />
                )}
                {entry.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <article>
      <h1 class="font-display text-ink text-[34px] leading-[1.15] font-semibold tracking-[-0.02em]">
        {doc.data.title}
      </h1>
      <p class="text-ink-muted mt-3 text-[17px]">{doc.data.description}</p>
      <div class="prose text-ink-muted mt-10 text-[16px]">
        <Content />
      </div>
    </article>
  </div>
</Base>
