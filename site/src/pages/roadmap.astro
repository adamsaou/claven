---
import Base from '../layouts/Base.astro'
import { MILESTONES } from '../lib/roadmap'

const dot: Record<string, string> = {
  done: 'bg-success',
  current: 'bg-ember',
  planned: 'bg-line'
}
const label: Record<string, string> = {
  done: 'done',
  current: 'in progress',
  planned: 'planned'
}
---

<Base
  title="Roadmap"
  description="Seven milestones, what finishes each one, and where Claven currently is."
>
  <div class="mx-auto max-w-5xl px-5 py-16">
    <h1 class="font-display text-ink text-[34px] font-semibold tracking-[-0.02em]">Roadmap</h1>
    <p class="text-ink-muted mt-4 max-w-2xl text-[15px]">
      No dates. Claven is built in evenings and a date would be a promise made
      with someone else's time. What is here instead is the order, and the
      condition that ends each milestone — vague milestones never finish.
    </p>

    <ol class="mt-12 space-y-0">
      {
        MILESTONES.map((milestone) => (
          <li class="border-line grid grid-cols-[auto_1fr] gap-x-4 border-t py-6 sm:grid-cols-[6rem_1fr]">
            <div class="flex items-baseline gap-2.5">
              <span class={`mt-1.5 h-1.5 w-1.5 shrink-0 ${dot[milestone.status]}`} aria-hidden="true" />
              <span class="font-mono text-ink text-[13px]">{milestone.id}</span>
            </div>
            <div>
              <h2 class="font-display text-ink text-[20px] font-semibold">
                {milestone.title}
                <span class="text-ink-dim ms-3 align-middle text-[10px] font-medium uppercase" style="letter-spacing: 0.14em">
                  {label[milestone.status]}
                </span>
              </h2>
              <p class="text-ink-muted mt-2 max-w-2xl text-[15px]">{milestone.detail}</p>
              {milestone.doneWhen !== undefined && (
                <p class="text-ink-dim mt-2 text-[13px]">
                  Done when: {milestone.doneWhen}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <p class="text-ink-dim border-line mt-12 border-t pt-8 text-[13px]">
      M1 to M4 are identical whichever direction Claven eventually takes, which
      is why the product question waits until M5 rather than being guessed at
      now.
    </p>
  </div>
</Base>
